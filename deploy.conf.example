# deploy.conf is gitignored — never commit real credentials.
# Copy this file to deploy.conf and fill in your details:
#   cp deploy.conf.example deploy.conf

FTP_HOST=ftp.example.com
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password
FTP_PORT=21

# Path on the server that maps to the site root (index.php lives here)
REMOTE_PATH=/httpdocs

